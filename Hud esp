    XRay = true,          -- Ver enemigos a traves de paredes
    Aimbot = false,       -- Seguimiento continuo al enemigo mas cercano dentro del FOV
    ShowFOV = true,       -- Mostrar circulo de FOV en pantalla
    FOVRadius = 130,      -- Radio del circulo de FOV en pixeles
    TeamCheck = false,    -- En Gakuran suele ser FFA; activable desde el HUD
    Minimized = false,
    AimHeadFirst = true,
    Prediction = 0.12
}

-- Contenedor UI compatible con Delta (gethui / CoreGui / PlayerGui)
local function getGuiParent()
    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then
            return hui
        end
    end

    local okCore, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if okCore and coreGui then
        local testOk = pcall(function()
            local probe = Instance.new("Folder")
            probe.Name = "GakuranFovProbe"
            probe.Parent = coreGui
            probe:Destroy()
        end)
        if testOk then
            return coreGui
        end
    end

    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then
        pcall(function()
            pg = LocalPlayer:WaitForChild("PlayerGui", 5)
        end)
    end
    return pg
end

local guiParent = getGuiParent()
if not guiParent then
    return
end

pcall(function()
    local old = guiParent:FindFirstChild("GakuranFovHUD")
    if old then old:Destroy() end
end)

