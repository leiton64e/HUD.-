local fovPresets = { 90, 130, 180, 240 }
createAction("TAMANO FOV: " .. tostring(Settings.FOVRadius), 192, function(btn)
    local nextIdx = 1
    for i, r in ipairs(fovPresets) do
        if r == Settings.FOVRadius then
            nextIdx = (i % #fovPresets) + 1
            break
        end
    end
    Settings.FOVRadius = fovPresets[nextIdx]
    FovCircle.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
    btn.Text = "TAMANO FOV: " .. tostring(Settings.FOVRadius)
