    Content.Visible = not state
    MinimizeBtn.Text = state and "+" or "−"
    Main.Size = state
        and UDim2.new(0, PANEL_W, 0, MINIMIZED_H)
        or UDim2.new(0, PANEL_W, 0, EXPANDED_H)
