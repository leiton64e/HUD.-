-- Logica de enemigos, ESP, Nombres y Aimbot continuo dentro del FOV
local Highlights = {}
local NameTags = {}

local function getAliveRoot(player)
    if not player or player == LocalPlayer then return nil, nil, nil end
    if Settings.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then return nil, nil, nil end
    local char = player.Character
    if not char then return nil, nil, nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not root then return nil, nil, nil end
    return char, hum, root
end

local function getAimPoint(char)
    if not char then return nil end
    local part = Settings.AimHeadFirst
        and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
        or (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
    if not part then return nil end
    local vel = part.AssemblyLinearVelocity or Vector3.zero
    return part.Position + (vel * Settings.Prediction)
end

local function clearVisualsFor(player)
    if Highlights[player] then
        pcall(function() Highlights[player]:Destroy() end)
        Highlights[player] = nil
    end
    if NameTags[player] then
        pcall(function() NameTags[player]:Destroy() end)
        NameTags[player] = nil
    end
end

local function ensureHighlight(player, char, isLockedTarget)
    local hl = Highlights[player]
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "GakuranHL"
        hl.OutlineColor = Color3.new(1, 1, 1)
        hl.Parent = char
        Highlights[player] = hl
    elseif hl.Parent ~= char then
        hl.Parent = char
    end

    hl.DepthMode = Settings.XRay
        and Enum.HighlightDepthMode.AlwaysOnTop
        or Enum.HighlightDepthMode.Occluded

    hl.FillColor = isLockedTarget
        and Color3.fromRGB(255, 175, 0)
        or Color3.fromRGB(255, 65, 65)
    hl.FillTransparency = 0.45
    hl.OutlineTransparency = 0
end

local function ensureNameTag(player, root, distStuds, isLockedTarget)
    local tag = NameTags[player]
    if not tag then
        tag = Instance.new("BillboardGui")
        tag.Name = "GakuranNameTag"
        tag.Size = UDim2.new(0, 150, 0, 24)
        tag.StudsOffset = Vector3.new(0, 3.2, 0)
        tag.AlwaysOnTop = Settings.XRay
        tag.Parent = root

        local lbl = Instance.new("TextLabel")
        lbl.Name = "Label"
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextStrokeTransparency = 0.2
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.TextSize = 12
        lbl.Font = Enum.Font.GothamBold
        lbl.Parent = tag
        NameTags[player] = tag
    else
        if tag.Parent ~= root then
            tag.Parent = root
        end
        tag.AlwaysOnTop = Settings.XRay
    end

    local lbl = tag:FindFirstChild("Label")
    if lbl then
        lbl.Text = string.format("%s [%.0fm]", player.DisplayName, distStuds)
        lbl.TextColor3 = isLockedTarget
            and Color3.fromRGB(255, 195, 40)
            or Color3.new(1, 1, 1)
    end
end

local function findClosestEnemyInFOV()
    if not Camera then Camera = workspace.CurrentCamera end
    if not Camera then return nil end

    local vp = Camera.ViewportSize
    local screenCenter = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    local myChar, _, myRoot = getAliveRoot(LocalPlayer)
    local originPos = myRoot and myRoot.Position or Camera.CFrame.Position

    local bestTarget = nil
    local bestDist = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        local char, _, root = getAliveRoot(plr)
        if char and root then
            local aimPos = getAimPoint(char)
            if aimPos then
                local screenPt, onScreen = Camera:WorldToViewportPoint(aimPos)
                if onScreen and screenPt.Z > 0 then
                    local distFromCenter = (Vector2.new(screenPt.X, screenPt.Y) - screenCenter).Magnitude
                    if distFromCenter <= Settings.FOVRadius then
                        local worldDist = (root.Position - originPos).Magnitude
                        if worldDist < bestDist then
                            bestDist = worldDist
                            bestTarget = {
                                player = plr,
                                char = char,
                                root = root,
                                aimPos = aimPos,
                                worldDist = worldDist
                            }
                        end
                    end
                end
            end
        end
    end

    return bestTarget
end

Players.PlayerRemoving:Connect(clearVisualsFor)

RunService.RenderStepped:Connect(function()
    pcall(function()
        if not Camera then
            Camera = workspace.CurrentCamera
        end
        if not Camera then
            return
        end

        local vp = Camera.ViewportSize
        FovCircle.Position = UDim2.new(0, vp.X * 0.5, 0, vp.Y * 0.5)
        FovCircle.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
        FovCircle.Visible = Settings.ShowFOV

        local locked = findClosestEnemyInFOV()
        local lockedPlayer = locked and locked.player or nil

        if locked then
            InfoLabel.Text = string.format("Fijado: %s (%.0fm)", locked.player.DisplayName, locked.worldDist)
            InfoLabel.TextColor3 = Color3.fromRGB(255, 200, 70)
            FovStroke.Color = Color3.fromRGB(255, 180, 30)
        else
            InfoLabel.Text = "Objetivo: Ninguno en FOV"
            InfoLabel.TextColor3 = Color3.fromRGB(185, 200, 225)
            FovStroke.Color = Color3.fromRGB(90, 170, 255)
        end

        if Settings.Aimbot and locked and locked.aimPos then
            if Camera.CameraType ~= Enum.CameraType.Scriptable then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, locked.aimPos)
            end
        end

        local _, _, myRoot = getAliveRoot(LocalPlayer)
        local myPos = myRoot and myRoot.Position or Camera.CFrame.Position

        for _, plr in ipairs(Players:GetPlayers()) do
            local char, _, root = getAliveRoot(plr)
            local isLocked = (plr == lockedPlayer)

            if char and root then
                if Settings.ESP then
                    ensureHighlight(plr, char, isLocked)
                elseif Highlights[plr] then
                    pcall(function() Highlights[plr]:Destroy() end)
                    Highlights[plr] = nil
                end

                if Settings.Names then
                    local d = (root.Position - myPos).Magnitude
                    ensureNameTag(plr, root, d, isLocked)
                elseif NameTags[plr] then
                    pcall(function() NameTags[plr]:Destroy() end)
                    NameTags[plr] = nil
                end
            else
                clearVisualsFor(plr)
            end
        end
    end)
end)
